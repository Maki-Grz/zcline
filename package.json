{
    "name": "zcline",
    "version": "0.1.0-alpha.1",
    "private": true,
    "workspaces": [
        "sdk/packages/*",
        "apps/vscode",
        "apps/vscode/webview-ui",
        "apps/vscode/testing-platform"
    ],
    "scripts": {
        "prepare": "husky",
        "build": "bun run build:sdk && cd apps/vscode/webview-ui && bun run build && cd .. && node esbuild.mjs",
        "build:sdk": "bun --production -F './sdk/packages/*' build",
        "build:vscode": "cd apps/vscode/webview-ui && bun run build && cd .. && node esbuild.mjs",
        "package:vscode": "cd apps/vscode && bunx vsce package --no-dependencies",
        "clean": "bun run sdk/scripts/clean.ts",
        "types": "bun --parallel -F '*' typecheck",
        "test": "bun --cwd sdk/packages/llms test && cd apps/vscode/webview-ui && bun test",
        "biome": "bunx --bun @biomejs/biome",
        "format": "bun biome format sdk/ apps/vscode/",
        "lint": "bun biome lint sdk/ apps/vscode/"
    },
    "lint-staged": {
        "sdk/**": [
            "sh -c 'bun run types'",
            "bun biome check --no-errors-on-unmatched --files-ignore-unknown=true"
        ]
    },
    "module": "index.ts",
    "type": "module",
    "engines": {
        "bun": "1.3.13",
        "node": ">=22"
    },
    "devDependencies": {
        "@biomejs/biome": "2.4.5",
        "@types/bun": "^1.3.13",
        "@types/node": "^25.3.5",
        "husky": "^9.1.7",
        "lint-staged": "^16.3.2",
        "vitest": "^4.0.18"
    },
    "peerDependencies": {
        "nanoid": "^5.1.7",
        "typescript": "^5.9.3"
    },
    "overrides": {
        "axios": "1.18.0",
        "fast-uri": ">=3.1.4",
        "undici@>=6.0.0 <7.0.0": "6.28.0",
        "@opentui/core": "0.4.3",
        "@opentui/react": "0.4.3",
        "tar-fs": ">=3.1.1",
        "tar": "^7.5.2",
        "js-yaml": "^4.1.1",
        "serialize-javascript": ">=7.0.3",
        "protobufjs": "7.6.5",
        "mermaid": "11.16.0",
        "diff": "8.0.4",
        "@sap-cloud-sdk/connectivity": "4.6.0",
        "@sap-cloud-sdk/http-client": "4.6.0",
        "@sap-cloud-sdk/openapi": "4.6.0",
        "@sap-cloud-sdk/resilience": "4.6.0",
        "@sap-cloud-sdk/util": "4.6.0"
    },
    "trustedDependencies": [
        "better-sqlite3",
        "grpc-tools"
    ],
    "packageManager": "bun@1.3.13"
}
